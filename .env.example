ANTHROPIC_API_KEY=
OPENAQ_API_KEY=
GUARDIAN_API_KEY=
REDDIT_USER_AGENT=cityscan/1.0
TFL_APP_KEY=
SCORE_WEIGHTS=0.20,0.20,0.20,0.20,0.20
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
MCP_PORT=8002
MCP_HOST=127.0.0.1

# MCP authentication (optional — set a secret token for network auth)
MCP_AUTH_TOKEN=
# Docker override: set to 'chromadb' when running via docker-compose
# CHROMADB_HOST=chromadb

# Doctor Agent access code (optional — if set, queries require this code)
# Leave empty for open access. Set for deployed instances to control LLM cost.
DOCTOR_ACCESS_CODE=

# Rate limiting for Doctor Agent queries (optional — defaults shown)
AGENT_RATE_LIMIT_PER_IP_HOUR=15
AGENT_RATE_LIMIT_PER_IP_DAY=40
AGENT_RATE_LIMIT_GLOBAL_DAY=150
