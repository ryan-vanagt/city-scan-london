FROM python:3.11-slim

WORKDIR /app

COPY api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY api/ ./api/
COPY agents/ ./agents/
COPY pipeline/__init__.py ./pipeline/__init__.py
COPY pipeline/schemas.py ./pipeline/schemas.py
COPY pipeline/lookups.json ./pipeline/lookups.json

RUN useradd --no-create-home --system appuser && chown -R appuser:appuser /app
USER appuser

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
