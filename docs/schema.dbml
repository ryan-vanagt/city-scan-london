// CityScan London — DuckDB schema
// Paste into https://dbdiagram.io to visualise
//
// Architecture: Bronze (JSON files) → Silver (normalised metrics) → Gold (aggregated scores)
// All scores are 0–100, where 100 = healthiest.

Table silver_metrics {
  borough_code     varchar [not null, note: 'ONS 9-char code (E09000001–E09000033)']
  borough_name     varchar [not null]
  timestamp        timestamptz [not null, note: 'UTC']
  metric_name      varchar [not null, note: 'air_quality | transit | sentiment | crime | nhs_ae | green_space | green_space_access']
  raw_value        double [note: 'Original value before normalisation (nullable for some sources)']
  normalised_score double [not null, note: '0–100 score, 100 = healthiest, CHECK 0–100']
  source           varchar [not null, note: 'openaq | tfl | reddit | guardian | bbc | met_police | nhs_ae | green_space']
  ingested_at      timestamptz [not null, note: 'UTC pipeline run time']
  pipeline_stage   varchar [default: 'silver']
}

Table gold_scores {
  borough_code              varchar [not null, note: 'ONS 9-char code']
  borough_name              varchar [not null]
  timestamp                 timestamptz [not null, note: 'UTC']
  air_score                 double [note: '0–100, from OpenAQ PM2.5 + NO2, CHECK 0–100']
  transit_score             double [note: '0–100, from TfL tube line status, CHECK 0–100']
  sentiment_score           double [note: '0–100, from Guardian + BBC sentiment (Reddit inactive), CHECK 0–100']
  immune_score              double [note: '0–100, from Met Police crime + NHS A&E performance, CHECK 0–100']
  green_space_score         double [note: '0–100, raw GLA Green Cover 2024 % per borough, CHECK 0–100']
  green_space_access_score  double [note: '0–100, ward-population-weighted green cover (access proxy), CHECK 0–100. Yearly static; backfilled to stable value by scripts/backfill_green_space_access.py']
  composite_score           double [not null, note: 'Weighted average of five organ scores; uses RAW green_space_score (not access-weighted) for stability, CHECK 0–100']
  ingested_at               timestamptz [not null, note: 'UTC pipeline run time']
  pipeline_stage            varchar [default: 'gold']
}

// Stored in separate file: data/agent_logs.duckdb (not cityscan.duckdb)
// Managed by agents/logging_db.py
Table agent_logs {
  id               varchar [pk, not null, note: 'UUID']
  timestamp        varchar [not null, note: 'ISO 8601 UTC']
  query            varchar [not null, note: 'User question']
  tools_called     varchar [note: 'JSON array of tool names']
  tool_inputs      varchar [note: 'JSON — parameters passed to each tool']
  tool_outputs     varchar [note: 'JSON — raw data returned by each tool']
  sources_cited    varchar [note: 'JSON — sources included in response']
  final_response   varchar [note: 'Full LLM answer text']
  latency_ms       integer [note: 'Total wall time in ms']
  model_used       varchar [note: 'e.g. claude-haiku-4-5']
}

Table bulletin_logs {
  id               varchar [pk, not null, note: 'UUID']
  timestamp        varchar [not null, note: 'ISO 8601 UTC']
  trigger          varchar [note: '"scheduled" or "manual"']
  scores_used      varchar [note: 'JSON snapshot of Gold scores at generation time']
  headlines_used   varchar [note: 'JSON array of headlines used']
  output_path      varchar [note: 'Path to saved .md file']
  latency_ms       integer [note: 'Total wall time in ms']
}

Table silver_detail {
  borough_code varchar [not null, note: 'ONS 9-char code']
  borough_name varchar [not null]
  timestamp    timestamptz [not null, note: 'UTC']
  source       varchar [not null, note: 'met_police | tfl | openaq | nhs_ae | green_space']
  category     varchar [not null, note: 'Crime type / tube line id / pollutant / org_code / green_cover']
  label        varchar [not null, note: 'Human-readable display name (ward name for green_space)']
  value        double [note: 'Count (1.0 per crime) / severity / reading / pct / green cover %']
  detail_text  varchar [note: 'Street name / TfL reason text / NHS period / ward code']
  ingested_at  timestamptz [not null, note: 'UTC pipeline run time']
}

Table silver_headlines {
  timestamp       timestamptz [not null, note: 'UTC']
  source          varchar [not null, note: 'reddit | bbc | guardian']
  title           varchar [not null, note: 'Headline text (no article body)']
  url             varchar [note: 'Link to source article (domain-validated)']
  sentiment_score double [note: 'Per-title sentiment score, -1 to +1']
  ingested_at     timestamptz [not null, note: 'UTC pipeline run time']
}

// Relationships: Silver feeds Gold (aggregation, not a FK join)
// silver_metrics ->> gold_scores via borough_code + timestamp grouping
// silver_detail + silver_headlines are queryable by agent but do NOT feed into gold scores
